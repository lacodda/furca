{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Furca",
  "version": "0.6.0",
  "identifier": "com.lacodda.furca",
  "mainBinaryName": "furca-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Furca",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#1d181a",
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ElasticOverscroll"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A fast git client that stays out of your way.",
    "longDescription": "Furca reads through gitoxide in-process and mutates through your own git, so hooks, credentials and LFS behave exactly like the terminal."
  }
}
