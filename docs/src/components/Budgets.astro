---
// The promises come from the same file the benchmark reads, so the page
// cannot promise what the gate does not hold. The measurements come from the
// releases: each release carries the numbers its own CI run measured, one
// JSON per platform, and this page is rebuilt when a release is published.
import promises from '../../../crates/furca-core/benches/budgets.json';

interface Result {
	name: string;
	layout: string;
	budget_ms: number | null;
	median_ms: number;
	p90_ms: number;
	within: boolean;
}
interface Report {
	version: string;
	os: string;
	arch: string;
	results: Result[];
}
interface Row {
	release: string;
	platform: string;
	result: Result;
}

const REPO = 'lacodda/furca';

async function releaseReports(): Promise<Row[]> {
	const headers: Record<string, string> = { Accept: 'application/vnd.github+json' };
	if (process.env.GITHUB_TOKEN) headers.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;

	// A failed read fails the build: an empty table published as if there were
	// nothing to show is the silent default this page exists to avoid.
	const response = await fetch(`https://api.github.com/repos/${REPO}/releases?per_page=100`, { headers });
	if (!response.ok) {
		throw new Error(`budgets page: cannot list releases (${response.status} ${response.statusText})`);
	}
	const releases: { tag_name: string; draft: boolean; assets: { name: string; browser_download_url: string }[] }[] =
		await response.json();

	const rows: Row[] = [];
	for (const release of releases.filter((r) => !r.draft)) {
		for (const asset of release.assets.filter((a) => /^budgets-.+\.json$/.test(a.name))) {
			const file = await fetch(asset.browser_download_url, { headers: { Accept: 'application/octet-stream' } });
			if (!file.ok) {
				throw new Error(`budgets page: cannot read ${asset.name} of ${release.tag_name} (${file.status})`);
			}
			const report: Report = await file.json();
			for (const result of report.results) {
				rows.push({ release: release.tag_name, platform: `${report.os} ${report.arch}`, result });
			}
		}
	}
	return rows;
}

// The published page is built in CI only, and there a failed read fails the
// build. A local build may be offline, or out of anonymous API calls - sixty
// an hour per address, shared by everything on the machine - so it goes on
// without the measurements and says so on the page and in its log.
let rows: Row[] = [];
let unread: string | null = null;
try {
	rows = await releaseReports();
} catch (error) {
	if (process.env.CI === 'true') throw error;
	unread = error instanceof Error ? error.message : String(error);
	console.warn(`${unread}; the page is built without the measurements, which a CI build would refuse`);
}
const measured = promises.budgets.filter((b) => b.status === 'measured');
const planned = promises.budgets.filter((b) => b.status === 'planned');
const ms = (value: number) => `${value.toLocaleString('en-US', { maximumFractionDigits: 1 })} ms`;
const commits = promises.commits.toLocaleString('en-US');
---

<h2 id="promised">Promised</h2>
<p>Measured on a synthetic repository of {commits} commits - a mainline with merged feature branches, open branches, tags and commits from slow clocks.</p>
<table>
	<thead><tr><th>What</th><th>Repository</th><th>Budget</th></tr></thead>
	<tbody>
		{measured.map((b) => (
			<tr>
				<td>{b.what}</td>
				<td><code>{b.layout}</code></td>
				<td>{b.limit_ms === null ? <em>measured, not promised</em> : `< ${b.limit_ms} ms`}</td>
			</tr>
		))}
		{planned.map((b) => (
			<tr>
				<td>{b.what}</td>
				<td><code>{b.layout}</code></td>
				<td>{`< ${b.limit_ms} ms`}, measured from {b.arrives}</td>
			</tr>
		))}
	</tbody>
</table>
{measured.filter((b) => b.note).map((b) => <p><strong><code>{b.layout}</code>:</strong> {b.note}</p>)}

<h2 id="measured">Measured</h2>
{unread !== null ? (
	<p><strong>Not read in this build:</strong> {unread}. The published page is built in CI, which fails rather than leave this table out.</p>
) : rows.length === 0 ? (
	<p>No release carries measurements yet: the first one to do so is v0.2.0.</p>
) : (
	<table>
		<thead><tr><th>Release</th><th>Platform</th><th>Repository</th><th>Median</th><th>90th percentile</th><th>Budget</th></tr></thead>
		<tbody>
			{rows.map((row) => (
				<tr>
					<td>{row.release}</td>
					<td>{row.platform}</td>
					<td><code>{row.result.layout}</code></td>
					<td>{ms(row.result.median_ms)}</td>
					<td>{ms(row.result.p90_ms)}</td>
					<td>{row.result.budget_ms === null ? '-' : row.result.within ? `kept (< ${row.result.budget_ms} ms)` : `broken (< ${row.result.budget_ms} ms)`}</td>
				</tr>
			))}
		</tbody>
	</table>
)}
